{
  "name": "@dsh-ops/plugin-rq-card",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "元冰可会话侧注入插件（WP-06，experimental）：四态执行卡片 + 👍/👎 反馈条，dsh.client 双面插件（浏览器半经 /plugins/<id>/client.js 下发；W5 起宿主耦合面经 host-port.ts 窄端口收敛，dsh 升级只需重跑 npm run test:contracts）",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "default": "./lib/client.js"
    },
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
